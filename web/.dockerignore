# Dependencies are installed inside the image by "npm ci".
# Both spellings on purpose: a bare pattern is unambiguous for the
# top-level directory, which is the 1.2GB one that slows context load.
node_modules
**/node_modules/
**/dist
build
.cache
**/.cache

.git
.gitignore
npm-debug.log
.coverage
.coverage.*
.env
.aws
.DS_Store
**/.DS_Store

# NOTE: do not ignore ./cert - run.sh needs it to serve over HTTPS
